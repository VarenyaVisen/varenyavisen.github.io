---
// Experience: one block per company, newest first. Company + location + overall dates, then each role
// (title, type badge), an optional summary, and the projects built there (description, what I did,
// impact, stack chips, optional link). No diagrams or motion. Reads experience.yaml (chip colours via TechChip).
import { getCollection } from 'astro:content';
import Badge from '../ui/Badge.astro';
import TechChip from '../ui/TechChip.astro';

// Overall dates per company come from its roles: earliest start – latest end ("present" wins).
const companies = (await getCollection('experience'))
  .map((e) => e.data)
  .map((c) => {
    const ends = c.roles.map((r) => r.end);
    return {
      ...c,
      start: c.roles.map((r) => r.start).sort()[0],
      end: ends.includes('present') ? 'present' : ends.sort().at(-1)!,
    };
  })
  .sort((a, b) => b.start.localeCompare(a.start)); // "2025-09" style dates sort as text

// "2026-10" → "Oct 2026", "present" → "Present"; anything else ("TODO") is shown as written.
const month = (d: string) => {
  if (d === 'present') return 'Present';
  const date = new Date(`${d}-01T00:00:00Z`);
  return /^\d{4}-\d{2}$/.test(d) && !isNaN(date.getTime())
    ? date.toLocaleDateString('en', { month: 'short', year: 'numeric', timeZone: 'UTC' })
    : d;
};
const range = (start: string, end?: string) => (end ? `${month(start)} – ${month(end)}` : month(start));
---

<ol class="flex flex-col gap-20">
  {
    companies.map((job) => (
      <li>
        <article>
          <header class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
            <h3 class="flex flex-wrap items-baseline gap-x-3 gap-y-1 text-2xl sm:text-3xl">
              {job.companyUrl ? (
                <a href={job.companyUrl} class="text-accent hover:underline" target="_blank" rel="noopener">
                  {job.company}
                </a>
              ) : (
                <span class="text-accent">{job.company}</span>
              )}
              <span class="font-sans text-base font-normal text-muted">{job.location}</span>
            </h3>
            <p class="eyebrow whitespace-nowrap">{range(job.start, job.end)}</p>
          </header>

          <ul class="mt-4 flex flex-col gap-2">
            {job.roles.map((role) => (
              <li class="flex flex-wrap items-center gap-x-3 gap-y-1">
                <span class="font-mono font-bold">{role.title}</span>
                <Badge variant="box">{role.type}</Badge>
                {job.roles.length > 1 && <span class="font-mono text-xs text-muted">{range(role.start, role.end)}</span>}
              </li>
            ))}
          </ul>

          {job.summary && <p class="mt-4 max-w-[38rem] text-lg">{job.summary}</p>}

          {job.projects.length > 0 && (
            <>
              <p class="eyebrow mt-10 mb-2">Projects</p>
              <ul class="border-t border-dashed border-line">
                {job.projects.map((project) => (
                  // Mobile: one column (title, dates, text, stack). lg+: text on the left (~70 characters wide),
                  // dates + stack chips in a right-hand column.
                  <li class="project grid gap-y-2 border-b border-dashed border-line py-8 lg:gap-x-12">
                    <h4 class="text-lg">{project.name}</h4>
                    {project.start && (
                      <p class="font-mono text-xs text-muted lg:col-start-2 lg:row-start-1 lg:pt-1.5">
                        {range(project.start, project.end)}
                      </p>
                    )}

                    <div class="lg:col-start-1 lg:row-start-2">
                      <p class="text-muted">{project.description}</p>

                      <ul class="mt-4 flex flex-col gap-2">
                        {project.did.map((item) => (
                          <li class="flex gap-3">
                            <span class="font-mono text-muted" aria-hidden="true">→</span>
                            <span class="min-w-0">{item}</span>
                          </li>
                        ))}
                      </ul>

                      {project.impact && (
                        <p class="impact mt-4">
                          <span class="eyebrow">Impact</span>
                          <span>{project.impact}</span>
                        </p>
                      )}
                    </div>

                    {(project.stack.length > 0 || project.link) && (
                      <div class="mt-3 flex flex-col items-start gap-4 lg:col-start-2 lg:row-start-2 lg:mt-0">
                        <ul class="flex flex-wrap gap-2" aria-label="Stack">
                          {project.stack.map((tech, i) => (
                            <li>
                              <TechChip name={tech} tilt={i % 2 ? 1 : -1} />
                            </li>
                          ))}
                        </ul>
                        {project.link && (
                          <a href={project.link} class="font-mono text-sm text-accent hover:underline" target="_blank" rel="noopener">
                            link →
                          </a>
                        )}
                      </div>
                    )}
                  </li>
                ))}
              </ul>
            </>
          )}
        </article>
      </li>
    ))
  }
</ol>

<style>
  @media (min-width: 1024px) {
    .project {
      grid-template-columns: minmax(0, 38rem) minmax(0, 1fr); /* 38rem ≈ 70 characters of body text */
    }
  }

  /* Metrics callout: accent tint, mono text. */
  .impact {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    padding: 0.6rem 0.9rem;
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .impact .eyebrow {
    color: var(--accent);
  }
</style>
