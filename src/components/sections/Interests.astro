---
// Interests: bento cards (wide / tall / square) with an Instrument Serif title, a short line, an optional
// handwritten note and a small static ASCII drawing. Reads interests.yaml. (`images` aren't shown yet.)
import { getCollection } from 'astro:content';
import AsciiArt from '../ui/AsciiArt.astro';
import Annotation from '../ui/Annotation.astro';

const cards = (await getCollection('interests')).map((e) => e.data);

// Desktop grid is 3 columns: wide = 2 columns, tall = 2 rows, square = 1 cell. If the cells don't fill
// the last row, the last card stretches sideways so the grid has no hole.
// shortcut: assumes the hole ends up next to the last card (true for wide → tall → square); revisit if the order changes a lot.
const cells = cards.reduce((n, c) => n + (c.layout === 'square' ? 1 : 2), 0);
const gap = (3 - (cells % 3)) % 3;
// Columns each card spans on desktop. Any card 2+ columns wide gets the side-by-side (wide) layout.
const spans = cards.map((c, i) => Math.min(3, (c.layout === 'wide' ? 2 : 1) + (i === cards.length - 1 ? gap : 0)));
---

<ul class="bento">
  {
    cards.map((card, i) => (
      <li
        class:list={['card', { 'card-wide': spans[i] > 1, 'card-tall': card.layout === 'tall' }]}
        style={`--span: ${spans[i]}`}
      >
        <div class="copy">
          <h3 class="font-serif text-4xl font-normal sm:text-5xl">{card.title}</h3>
          {card.text && <p class="mt-3 text-muted">{card.text}</p>}
        </div>
        {(card.art || card.note) && (
          <div class="art">
            {card.note && <Annotation text={card.note} arrow="down" class="ml-2" />}
            {card.art && <AsciiArt rows={card.art} />}
          </div>
        )}
      </li>
    ))
  }
</ul>

<style>
  .bento {
    display: grid;
    gap: 1.25rem;
  }

  /* Big rounded card: ink outline + hard shadow in light mode, thin border + glow in dark (tokens). */
  .card {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    min-width: 0;
    padding: 1.5rem;
    border: var(--border-w) solid var(--line);
    border-radius: var(--radius-xl);
    background: var(--surface);
    box-shadow: var(--shadow-pop);
  }
  .card h3 {
    font-family: var(--font-serif);
    letter-spacing: 0;
    line-height: 1.05;
  }
  .art {
    margin-top: auto; /* drawing sits at the bottom of the card */
  }

  @media (min-width: 768px) {
    .bento {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-flow: dense;
    }
    .card {
      padding: 2rem;
      grid-column: span var(--span);
    }
    .card-wide {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      align-items: end;
      gap: 2rem;
    }
    .card-tall {
      grid-row: span 2;
    }
  }
</style>
