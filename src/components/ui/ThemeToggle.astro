---
// Sun/moon button that flips data-theme on <html> and saves the choice in localStorage.
// Which icon shows is pure CSS (based on data-theme), so it's right on first paint. Reads no YAML.
---

<button type="button" class="theme-toggle" data-theme-toggle aria-label="Toggle dark mode">
  <!-- sun -->
  <svg class="icon sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4.5"></circle>
    <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"></path>
  </svg>
  <!-- moon wearing a tiny nightcap -->
  <svg class="icon moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M19 14.5A7.5 7.5 0 1 1 10.2 5.3a6 6 0 0 0 8.8 9.2Z"></path>
    <path class="cap" d="M9.6 5.6 C 10.5 2.6, 14.2 1.4, 16.8 3.2 L 13.6 4.4 Z"></path>
    <circle class="pom" cx="17.4" cy="3" r="1.2"></circle>
  </svg>
</button>

<script>
  // Every toggle on the page shares this handler.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    button.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        // storage blocked (private mode): the toggle still works for this visit
      }
    });
  }
</script>

<style>
  .theme-toggle {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    border: 1.5px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }
  .theme-toggle:hover {
    color: var(--accent);
  }

  .icon {
    grid-area: 1 / 1;
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 400ms ease-out, opacity 250ms ease-out;
  }
  .moon .cap,
  .moon .pom {
    fill: var(--accent-2);
    stroke: var(--accent-2);
    stroke-width: 1;
  }

  /* Light: sun visible, moon rotated away. Dark: the reverse. */
  .moon {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }
  :global([data-theme="dark"]) .sun {
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }
  :global([data-theme="dark"]) .moon {
    opacity: 1;
    transform: none;
  }
</style>
