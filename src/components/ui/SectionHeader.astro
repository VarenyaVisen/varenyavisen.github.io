---
// Section heading: "02 · EXPERIENCE" eyebrow, big mono title, optional italic muted subtitle.
// The caller passes the text (from YAML in later phases). Reads no YAML itself.
interface Props {
  index: number; // shown zero-padded: 2 -> "02"
  label: string;
  title: string;
  subtitle?: string;
}

const { index, label, title, subtitle } = Astro.props;
---

<header class="mb-10 max-w-3xl">
  <p class="eyebrow mb-3">{String(index).padStart(2, '0')} · {label}</p>
  <h2 class="text-3xl sm:text-5xl">{title}</h2>
  {subtitle && <p class="mt-3 font-mono text-lg italic text-muted sm:text-2xl">{subtitle}</p>}
</header>
