---
// Page footer: name, "Built with Astro · last updated {build date}" and a tiny paper-plane doodle.
// Reads profile.yaml (name only).
import { getEntry } from 'astro:content';

const profile = await getEntry('profile', 'profile');
const built = new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<footer class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 border-t border-dashed border-line px-4 pt-8 pb-24 font-mono text-sm text-muted sm:px-8">
  <p>© {new Date().getFullYear()} {profile?.data.name}</p>
  <p class="flex items-center gap-2">
    Built with Astro · last updated {built}
    <!-- doodle: a paper plane with a loopy trail -->
    <svg viewBox="0 0 48 24" class="h-6 w-12 text-accent" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M2 20c6 0 8-6 13-6s3 5 0 5-2-7 6-9" stroke-dasharray="2 3"></path>
      <path d="M24 9 46 2 36 20l-4-7z M32 13 46 2"></path>
    </svg>
  </p>
</footer>
