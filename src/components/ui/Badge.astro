---
// Small label. "sticker" = slightly tilted pill (skill chips, tags); filled in light mode,
// outlined in dark mode. "box" = square spaced-caps tag like FULL-TIME. Reads no YAML.
interface Props {
  variant?: 'sticker' | 'box';
  color?: 'accent' | 'accent-2' | 'orange' | 'blue' | 'purple' | 'plain';
  tilt?: number; // degrees, keep within ±2
}

const { variant = 'sticker', color = 'plain', tilt = 0 } = Astro.props;

const colorVar = {
  accent: 'var(--accent-soft)',
  'accent-2': 'var(--accent-2-soft)',
  orange: 'var(--block-orange)',
  blue: 'var(--block-blue)',
  purple: 'var(--block-purple)',
  plain: 'var(--surface)',
}[color];

// In dark mode the fill turns into an outline + text color.
const darkVar = {
  accent: 'var(--accent)',
  'accent-2': 'var(--accent-2)',
  orange: 'var(--block-orange)',
  blue: 'var(--block-blue)',
  purple: 'var(--block-purple)',
  plain: 'var(--ink)',
}[color];
---

<span
  class:list={['badge', `badge-${variant}`]}
  style={`--badge-fill: ${colorVar}; --badge-dark: ${darkVar}; --tilt: ${tilt}deg;`}
>
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    line-height: 1;
    white-space: nowrap;
  }

  /* --is-light (tokens.css) picks the light look (filled, ink text) or the dark look (outlined, colored text). */
  .badge-sticker {
    padding: 0.4rem 0.75rem;
    border: 1.5px solid
      color-mix(in srgb, var(--line) var(--is-light), color-mix(in srgb, var(--badge-dark) 55%, transparent));
    border-radius: 999px;
    background: color-mix(
      in srgb,
      var(--badge-fill) var(--is-light),
      color-mix(in srgb, var(--badge-dark) 10%, transparent)
    );
    color: color-mix(in srgb, var(--ink) var(--is-light), var(--badge-dark));
    font-size: 0.8rem;
    font-weight: 500;
    transform: rotate(var(--tilt));
  }

  .badge-box {
    padding: 0.3rem 0.5rem;
    border: 1px solid var(--tag-border);
    border-radius: var(--radius-sm);
    color: var(--muted);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
</style>
