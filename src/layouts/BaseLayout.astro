---
// Page shell: <head>, fonts/styles, the no-flash theme script, floating nav, footer and Pause motion pill.
// Reads site.yaml for the default page title and description.
import '../styles/global.css';
import { getEntry } from 'astro:content';
import MotionToggle from '../components/ui/MotionToggle.astro';
import Nav from '../components/ui/Nav.astro';
import Footer from '../components/ui/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const site = await getEntry('site', 'site');
const { title = site?.data.title, description = site?.data.description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Runs before first paint so the page never flashes the wrong theme.
         Theme: saved choice, else the OS preference. Motion: saved "paused" choice. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var theme = null;
        var motion = null;
        try {
          theme = localStorage.getItem('theme');
          motion = localStorage.getItem('motion');
        } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        root.dataset.theme = theme;
        if (motion === 'paused') root.dataset.motion = 'paused';
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-surface focus:p-2">Skip to content</a>
    <Nav />
    <div id="main"><slot /></div>
    <Footer />
    <MotionToggle />

    <script>
      // One handler for every theme toggle on the page (any element with data-theme-toggle).
      document.addEventListener('click', (e) => {
        if (!(e.target as Element).closest('[data-theme-toggle]')) return;
        const root = document.documentElement;
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {
          // storage blocked (private mode): the toggle still works for this visit
        }
      });
    </script>
  </body>
</html>
